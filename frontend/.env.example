# Copy locally to .env.local; never commit local environment files.
VITE_SUPABASE_URL=<supabase-project-url>
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_APP_URL=http://localhost:5173
# Trusted FastAPI origin only (no /api/v1 path); set locally after Adel confirms it.
VITE_API_BASE_URL=<fastapi-origin>
# VITE_* values are public browser configuration. Never put secrets here.
