# Supabase Auth configuration for future BE-02 work. Replace locally; never commit real values.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Enable only for local BE-02 integration verification.
ENABLE_AUTH_PROBE=false

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend listen port.
PORT=8000

# ---------- TravelMate adapters (app/adapters/travelmate.py, API-04 / API-05) ----------
# Placeholders only. Full reference: prototypes/travel-adapter/.env.example and INTEGRATION_GUIDE.md.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
BOOKING_RAPIDAPI_KEYS=
GOOGLE_FLIGHTS_RAPIDAPI_KEYS=
# disabled (default) | live (Google Flights) | indicative (Skyscanner, information only)
TRAVELMATE_FLIGHT_MODE=live
TRAVELMATE_DEFAULT_DEADLINE_SECONDS=60
TRAVELMATE_APPROVED_POLICY_IDS=
# Keep false until a currency conversion policy is approved (non-USD prices are excluded with a warning).
TRAVELMATE_FX_CONVERSION=false
# Local development only; keep false in shared / deployed environments.
TRAVELMATE_LOCAL_KEY_ROTATION=false
TRAVELMATE_PRUNE_DEAD_KEYS=false
