# Dependencies and local runtimes (at any repository depth).
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Generated builds, caches and test output.
dist/
build/
coverage/
.vite/
*.tsbuildinfo
*.log

# Local environment values; safe examples must remain reviewable.
.env
.env.*
!.env.example

# Private keys and credential containers; never package these with the source.
*.pem
*.key
*.p12
*.pfx
*.jks

# Local operating-system metadata.
.DS_Store
Thumbs.db
