                      "price",
                      "taxes",
                      "airline",
                      "departure_airport_code",
                      "arrival_airport_code",
                      "outbound_departure_at",
                      "return_departure_at",
                      "adults"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "status",
                "offers"
              ],
              "additionalProperties": false
            },
            "hotels": {
              "type": "object",
