                        "additionalProperties": false
                      },
                      "airline": {
                        "type": "string",
                        "minLength": 1
                      },
                      "departure_airport_code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arrival_airport_code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "outbound_departure_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "Z$"
                      },
                      "return_departure_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "Z$"
                      },
                      "adults": {
