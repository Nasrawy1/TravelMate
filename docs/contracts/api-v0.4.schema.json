                          "amount_usd": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "kind": {
                            "enum": [
                              "provider",
                              "estimate",
                              "unknown"
                            ]
                          },
                          "coverage": {
                            "enum": [
                              "entire_trip_all_travelers",
                              "all_travelers",
                              null
                            ]
                          }
                        },
                        "required": [
                          "amount_usd",
                          "kind",
                          "coverage"
                        ],
                        "additionalProperties": false
                      },
                      "taxes": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "enum": [
