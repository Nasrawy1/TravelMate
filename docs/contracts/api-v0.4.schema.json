{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TravelMate API 0.4 candidate",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "departure_city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "description": "City name supported by the adapter's approved fixed 80-city mapping and name normalization. Trim surrounding whitespace before validation. Unsupported cities return 400 UNSUPPORTED_LOCATION; identical mapped cities return 422 VALIDATION_ERROR. Membership is semantic validation owned by the adapter, not a duplicated schema enum. See api-contracts.md section 3 (approved reconciliation 2026-10-25)."
        },
        "destination_city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "description": "City name supported by the adapter's approved fixed 80-city mapping and name normalization. Trim surrounding whitespace before validation. Unsupported cities return 400 UNSUPPORTED_LOCATION; identical mapped cities return 422 VALIDATION_ERROR. Membership is semantic validation owned by the adapter, not a duplicated schema enum. See api-contracts.md section 3 (approved reconciliation 2026-10-25)."
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "return_date": {
          "type": "string",
          "format": "date"
        },
        "adults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "departure_city",
        "destination_city",
        "start_date",
        "return_date",
        "adults",
        "budget_usd"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "generation_status": {
          "enum": [
            "complete"
          ]
        },
        "live_integration_status": {
          "enum": [
            "price_received",
            "no_price"
          ]
        },
        "trip": {
          "type": "object",
          "properties": {
            "departure_city": {
              "type": "string",
              "minLength": 1
            },
            "destination_city": {
              "type": "string",
              "minLength": 1
            },
            "start_date": {
              "type": "string",
              "format": "date"
            },
            "return_date": {
              "type": "string",
              "format": "date"
            },
            "nights": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "adults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "departure_city",
            "destination_city",
            "start_date",
            "return_date",
            "nights",
            "adults"
          ],
          "additionalProperties": false
        },
        "itinerary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "activities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "area": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cost": {
                      "type": "object",
                      "properties": {
                        "amount_usd": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "kind": {
                          "enum": [
                            "provider",
                            "estimate",
                            "unknown"
                          ]
                        },
                        "coverage": {
                          "enum": [
                            "entire_trip_all_travelers",
                            "all_travelers",
                            null
                          ]
                        }
                      },
                      "required": [
                        "amount_usd",
                        "kind",
                        "coverage"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "order",
                    "name",
                    "area",
                    "description",
                    "cost"
                  ],
                  "additionalProperties": false
                }
              },
              "empty_day_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "date",
              "activities",
              "empty_day_reason"
            ],
            "additionalProperties": false
          }
        },
        "travel_options": {
          "type": "object",
          "properties": {
            "flights": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "live",
                    "unavailable"
                  ]
