                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "retrieved_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "Z$"
                      },
                      "price": {
                        "type": "object",
                        "properties": {
                          "amount_usd": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "kind": {
                            "enum": [
                              "provider",
                              "estimate",
                              "unknown"
                            ]
                          },
                          "coverage": {
                            "enum": [
                              "entire_trip_all_travelers",
                              "all_travelers",
