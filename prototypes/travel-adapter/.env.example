# TravelMate configuration - copy this file to ".env" and fill in your own values.
# Placeholders only. Never commit the real ".env" file.

# ---------- AI provider (Groq, direct official API) ----------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Flight provider (Skyscanner Scraper API on RapidAPI) ----------
# One key = single-key mode. Several keys = comma-separated list (used in order).
SKYSCANNER_RAPIDAPI_KEYS=your_skyscanner_rapidapi_key_1
# Optional indexed form (merged with the list above, duplicates removed):
# SKYSCANNER_RAPIDAPI_KEY_1=your_skyscanner_rapidapi_key_1
# SKYSCANNER_RAPIDAPI_KEY_2=your_skyscanner_rapidapi_key_2

# ---------- Hotel provider (Booking COM "booking-com15" on RapidAPI) ----------
BOOKING_RAPIDAPI_KEYS=your_booking_rapidapi_key_1
# BOOKING_RAPIDAPI_KEY_1=your_booking_rapidapi_key_1
# BOOKING_RAPIDAPI_KEY_2=your_booking_rapidapi_key_2

# ---------- Adapter behavior ----------
# Mandatory category for a successful search ("hotels" or "flights"). Must match the PLAN-02 (#11) decision.
TRAVELMATE_MANDATORY_CATEGORY=hotels
# Set to false to mark the optional flight category as "unavailable".
TRAVELMATE_FLIGHTS_ENABLED=true
# Move to the next key ONLY when a key's quota is exhausted. Default false: issue #18 forbids rotating keys to bypass limits.
TRAVELMATE_KEY_ROTATION_ON_QUOTA=false
# Serve an expired (but < 7 days old) cached response when the provider is rate limited / down. Always labeled "stale_fallback".
TRAVELMATE_ALLOW_STALE_CACHE_FALLBACK=false
TRAVELMATE_CACHE_TTL_HOURS=12
TRAVELMATE_DEFAULT_DEADLINE_SECONDS=90
# Comma-separated list of reviewed ancillary estimation policy IDs (food / local transport). Empty = always "unknown".
TRAVELMATE_APPROVED_POLICY_IDS=
