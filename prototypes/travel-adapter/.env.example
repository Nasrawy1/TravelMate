# TravelMate travel adapter configuration - copy this file to ".env" and fill in your own values.
# Placeholders only. Never commit the real ".env" file.

# ---------- AI provider (Groq, direct official API) ----------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Hotel provider (Booking COM "booking-com15" on RapidAPI) ----------
# Only the FIRST key is used for requests (no key rotation inside a request).
BOOKING_RAPIDAPI_KEYS=your_booking_rapidapi_key_1
# Optional indexed form (merged with the list above, duplicates removed):
# BOOKING_RAPIDAPI_KEY_1=your_booking_rapidapi_key_1

# ---------- Live flight provider (Google Flights "google-flights2" on RapidAPI, 150 requests / month) ----------
GOOGLE_FLIGHTS_RAPIDAPI_KEYS=your_rapidapi_key_subscribed_to_google_flights

# ---------- Indicative flight provider (Skyscanner Scraper API on RapidAPI, information only) ----------
SKYSCANNER_RAPIDAPI_KEYS=your_skyscanner_rapidapi_key_1

# ---------- Adapter behavior ----------
# disabled   = flights "unavailable" / "not_configured", no flight provider calls (default, contract-safe)
# live       = Google Flights live round trips (real dates, all-adult totals, real departure times)
# indicative = cached Skyscanner quotes for INFORMATION ONLY (never selected, never sent to BE-04)
TRAVELMATE_FLIGHT_MODE=live
# Local maintenance only: after a quota-exhausted (429) or auth (401/403) failure, remove that key from this .env
# (backup in .env.bak) so the next key becomes primary for LATER requests. The failing request is never retried.
TRAVELMATE_PRUNE_DEAD_KEYS=false
# LOCAL DEVELOPMENT ONLY: move a dead key to .env.exhausted and continue with the next key in the SAME request.
# Approved by the team lead (PR #25 review); keep it off in shared / deployed environments.
TRAVELMATE_LOCAL_KEY_ROTATION=false
TRAVELMATE_CACHE_TTL_HOURS=12
TRAVELMATE_DEFAULT_DEADLINE_SECONDS=60
# Comma-separated reviewed estimation policy IDs (food / local transport). Empty = always "unknown".
TRAVELMATE_APPROVED_POLICY_IDS=

# Currency conversion of non-USD prices (PR #25 review, item 4). Keep false until the team approves a
# conversion policy: non-USD prices are then excluded with a CURRENCY_UNAVAILABLE warning.
TRAVELMATE_FX_CONVERSION=false
